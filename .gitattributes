# --- Submission archive (git archive) --------------------------------------
# export-ignore keeps a path in the repo but out of the archive. Everything not
# listed here is part of the archive. A directory is excluded by naming it
# (`dir`), not its contents (`dir/**`), so no empty directory is left behind;
# `dir/**` is used only where some files inside are kept with -export-ignore.
.gitignore export-ignore
.gitattributes export-ignore
packages.txt export-ignore
*.png export-ignore
/docs export-ignore
/figures export-ignore
/RESULTS_SUMMARY_2026 export-ignore
results_human_centric_rerun/* export-ignore
results_human_centric_rerun/04_capture_slots -export-ignore
results_human_centric_rerun/06_cross_domain_class_angles -export-ignore

